{
  "name": "pokemonstats",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-licenses.mjs",
    "lint": "oxlint",
    "test": "node --test src/lib/damage/*.test.js src/lib/*.test.js scripts/*.test.mjs",
    "data:regulation-mc": "node scripts/import-regulation-mc.mjs",
    "data:regulation": "node scripts/import-regulation.mjs",
    "data:check": "node scripts/check-regulation.mjs",
    "data:diff": "node scripts/compare-regulations.mjs",
    "data:simulate": "node scripts/simulate-regulations.mjs",
    "data:update": "node scripts/update-regulation.mjs",
    "verify": "npm run data:check -- --complete && npm test && npm run lint && npm run build",
    "preview": "vite preview",
    "assets:background": "node scripts/optimize-background.mjs",
    "assets:pokemon": "node scripts/import-pokemon-images.mjs"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "sharp": "^0.35.5",
    "vite": "^8.1.0"
  }
}
